      "Name": "Now Playing",
      "Icon": "assets/music.svg",
      "States": [{ "Name": "Now Playing", "Image": "assets/music.svg" }],
      "Tooltip": "Show artwork, playback state, title, artist, and optional 7 px progress",
      "UUID": "com.arkamax404.ulanzi.mediacontrol.nowplaying",
      "PropertyInspectorPath": "property-inspector/nowplaying/inspector.html",
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "Controllers": ["Keypad"],
      "Devices": ["D200"]
    },
    {
      "Name": "Large Now Playing",
      "Icon": "assets/largeitem-nowplaying.svg",
